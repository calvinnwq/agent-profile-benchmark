{
  "$id": "https://github.com/calvinnwq/agent-profile-benchmark/blob/main/schemas/aegis-01-output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allocation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "share"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "share": {
            "type": "number"
          }
        }
      }
    },
    "assumptions": {
      "minItems": 1,
      "type": "array"
    },
    "caveats": {
      "minItems": 1,
      "type": "array"
    },
    "constraint_gaps": {
      "minItems": 1,
      "type": "array"
    },
    "portfolio_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bonds",
        "cash",
        "equities",
        "total"
      ],
      "properties": {
        "bonds": {
          "type": "number"
        },
        "cash": {
          "type": "number"
        },
        "equities": {
          "type": "number"
        },
        "total": {
          "type": "number"
        }
      }
    },
    "recommendation": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "portfolio_totals",
    "allocation",
    "constraint_gaps",
    "recommendation",
    "assumptions",
    "caveats"
  ],
  "title": "AEGIS-01 candidate output",
  "type": "object"
}
