{
  "$id": "https://github.com/calvinnwq/agent-profile-benchmark/blob/main/schemas/arch-02-output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "location"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "remediation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "action"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string"
          }
        }
      }
    },
    "review_summary": {
      "minLength": 1,
      "type": "string"
    },
    "severity": {
      "additionalProperties": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high",
          "critical"
        ]
      },
      "type": "object"
    }
  },
  "required": [
    "findings",
    "severity",
    "evidence",
    "remediation",
    "review_summary"
  ],
  "title": "ARCH-02 candidate output",
  "type": "object"
}
