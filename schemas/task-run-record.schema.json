{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/calvinnwq/agent-profile-benchmark/blob/main/schemas/task-run-record.schema.json",
  "title": "Agent Profile Benchmark run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "benchmark_id",
    "benchmark_version",
    "task_id",
    "profile_id",
    "harness",
    "model_requested",
    "model_resolved",
    "condition",
    "evaluator_version",
    "prompt_fingerprint",
    "fixture_fingerprint",
    "started_at",
    "completed_at",
    "status",
    "raw_output_reference",
    "automatic_checks",
    "hard_failures",
    "human_scores",
    "latency_ms",
    "usage",
    "notes"
  ],
  "properties": {
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "benchmark_id": {"type": "string", "const": "agent-profile-benchmark"},
    "benchmark_version": {"type": "string", "const": "0.2.0"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{2}$"},
    "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "harness": {"type": "string", "enum": ["local-replay", "hermes-oneshot"]},
    "model_requested": {"type": "string", "minLength": 1},
    "model_resolved": {"type": "string", "minLength": 1},
    "condition": {"type": "string", "enum": ["known-good-control", "known-bad-control", "model-calibration"]},
    "evaluator_version": {"type": "string", "minLength": 1},
    "prompt_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fixture_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "started_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "completed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "status": {"type": "string", "enum": ["passed", "failed", "blocked"]},
    "raw_output_reference": {"type": "string", "minLength": 1},
    "automatic_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["pass", "fail", "blocked"]},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "hard_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "condition", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "condition": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "human_scores": {"type": "object"},
    "latency_ms": {"type": "integer", "exclusiveMinimum": -1},
    "usage": {"type": "object"},
    "notes": {"type": "string", "minLength": 1}
  }
}
