{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/calvinnwq/agent-profile-benchmark/blob/main/schemas/tolerant-analysis.schema.json",
  "title": "Tolerant objective analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "analysis_id",
    "benchmark_id",
    "benchmark_version",
    "input_snapshot_id",
    "input_manifest_fingerprint",
    "roster_snapshot_id",
    "generated_at",
    "release_lock_fingerprints",
    "strict_results_preserved",
    "recovery_policy",
    "metric_definitions",
    "coverage",
    "classification_counts",
    "overall_metrics",
    "models",
    "ranking",
    "runs"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "$id": {"type": "string"},
    "schema_version": {"type": "string", "const": "tolerant-analysis-v1"},
    "analysis_id": {"type": "string", "minLength": 1},
    "benchmark_id": {"type": "string", "const": "agent-profile-benchmark"},
    "benchmark_version": {"type": "string", "const": "0.4.1"},
    "input_snapshot_id": {"type": "string", "minLength": 1},
    "input_manifest_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "roster_snapshot_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "release_lock_fingerprints": {
      "type": "array",
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "strict_results_preserved": {"type": "boolean"},
    "recovery_policy": {"type": "object", "additionalProperties": true},
    "metric_definitions": {"type": "object", "additionalProperties": {"type": "string"}},
    "coverage": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "attempted_runs",
        "execution_eligible_runs",
        "strict_comparable_runs",
        "tolerant_recoverable_runs",
        "tolerant_judgeable_runs"
      ],
      "properties": {
        "attempted_runs": {"type": "integer", "exclusiveMinimum": -1},
        "execution_eligible_runs": {"type": "integer", "exclusiveMinimum": -1},
        "strict_comparable_runs": {"type": "integer", "exclusiveMinimum": -1},
        "tolerant_recoverable_runs": {"type": "integer", "exclusiveMinimum": -1},
        "tolerant_judgeable_runs": {"type": "integer", "exclusiveMinimum": -1}
      }
    },
    "classification_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "exclusiveMinimum": -1}
    },
    "overall_metrics": {"type": "object", "additionalProperties": true},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["model_id", "status", "availability", "coverage", "metrics", "task_cells"],
        "properties": {
          "model_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["ranked", "unranked", "excluded"]},
          "availability": {"type": "string", "enum": ["eligible", "excluded"]},
          "coverage": {"type": "object", "additionalProperties": true},
          "metrics": {"type": "object", "additionalProperties": true},
          "task_cells": {"type": "array"}
        }
      }
    },
    "ranking": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "primary_metric", "ranked", "unranked", "excluded"],
      "properties": {
        "status": {"type": "string", "const": "diagnostic-only"},
        "primary_metric": {"type": "string", "minLength": 1},
        "ranked": {"type": "array"},
        "unranked": {"type": "array"},
        "excluded": {"type": "array"}
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "run_id",
          "record_path",
          "raw_output_reference",
          "raw_output_fingerprint",
          "model_id",
          "task_id",
          "profile_id",
          "execution_eligible",
          "strict_contract_valid",
          "strict_objective_pass",
          "recovery",
          "tolerant_recoverable",
          "tolerant_judgeable",
          "tolerant_evaluation_status",
          "tolerant_automatic_check_pass",
          "tolerant_objective_pass"
        ],
        "properties": {
          "run_id": {"type": "string", "minLength": 1},
          "record_path": {"type": "string", "minLength": 1},
          "raw_output_reference": {"type": "string", "minLength": 1},
          "raw_output_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "model_id": {"type": "string", "minLength": 1},
          "task_id": {"type": "string", "minLength": 1},
          "profile_id": {"type": "string", "minLength": 1},
          "execution_eligible": {"type": "boolean"},
          "strict_contract_valid": {"type": "boolean"},
          "strict_objective_pass": {"type": "boolean"},
          "recovery": {"type": "object", "additionalProperties": true},
          "tolerant_recoverable": {"type": "boolean"},
          "tolerant_judgeable": {"type": "boolean"},
          "tolerant_evaluation_status": {"type": "string", "minLength": 1},
          "tolerant_automatic_check_pass": {"type": "boolean"},
          "tolerant_objective_pass": {"type": "boolean"}
        }
      }
    }
  }
}
