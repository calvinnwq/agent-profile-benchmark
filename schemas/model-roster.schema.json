{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/calvinnwq/agent-profile-benchmark/blob/main/schemas/model-roster.schema.json",
  "title": "Versioned model roster snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_version",
    "snapshot_id",
    "provider",
    "captured_at",
    "models"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "$id": {"type": "string"},
    "schema_version": {"type": "string", "const": "model-roster-v1"},
    "benchmark_id": {"type": "string", "const": "agent-profile-benchmark"},
    "benchmark_version": {"type": "string", "const": "0.2.0"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "minLength": 1},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "requested_model_id",
          "resolved_model_id",
          "provider_requested",
          "provider_resolved",
          "availability"
        ],
        "properties": {
          "model_id": {"type": "string", "minLength": 1},
          "requested_model_id": {"type": "string", "minLength": 1},
          "resolved_model_id": {"type": "string", "minLength": 1},
          "provider_requested": {"type": "string", "minLength": 1},
          "provider_resolved": {"type": "string", "minLength": 1},
          "availability": {"type": "string", "enum": ["eligible", "excluded"]},
          "exclusion_reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
