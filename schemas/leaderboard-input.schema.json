{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/calvinnwq/agent-profile-benchmark/blob/main/schemas/leaderboard-input.schema.json",
  "title": "Versioned leaderboard input manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_version",
    "snapshot_id",
    "roster_path",
    "runs"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "$id": {"type": "string"},
    "schema_version": {"type": "string", "const": "leaderboard-input-v1"},
    "benchmark_id": {"type": "string", "const": "agent-profile-benchmark"},
    "benchmark_version": {"type": "string", "const": "0.2.0"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "roster_path": {"type": "string", "minLength": 1},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "record_path"],
        "properties": {
          "run_id": {"type": "string", "minLength": 1},
          "record_path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
