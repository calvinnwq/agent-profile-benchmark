{
  "$id": "https://github.com/calvinnwq/agent-profile-benchmark/blob/main/schemas/sentinel-01-output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_ids": {
      "minItems": 1,
      "type": "array"
    },
    "health_state": {
      "minLength": 1,
      "type": "string"
    },
    "next_actions": {
      "minItems": 1,
      "type": "array"
    },
    "root_cause": {
      "minLength": 1,
      "type": "string"
    },
    "severity": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "health_state",
    "evidence_ids",
    "severity",
    "root_cause",
    "next_actions",
    "confidence"
  ],
  "title": "SENTINEL-01 candidate output",
  "type": "object"
}
