{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/calvinnwq/agent-profile-benchmark/blob/main/schemas/leaderboard-output.schema.json",
  "title": "Generated Agent Profile Benchmark leaderboard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_version",
    "policy_id",
    "policy_version",
    "input_snapshot_id",
    "roster_snapshot_id",
    "generated_at",
    "scope",
    "models",
    "aggregate",
    "overall",
    "profiles",
    "publication",
    "input"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "$id": {"type": "string"},
    "schema_version": {"type": "string", "const": "leaderboard-v1"},
    "benchmark_id": {"type": "string", "const": "agent-profile-benchmark"},
    "benchmark_version": {"type": "string", "const": "0.4.0"},
    "policy_id": {"type": "string", "const": "leaderboard-v1"},
    "policy_version": {"type": "string", "const": "1.0.0"},
    "input_snapshot_id": {"type": "string", "minLength": 1},
    "roster_snapshot_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "release_lock_fingerprint": {"type": "string"},
    "scope": {"type": "string", "const": "benchmark-specific model leaderboard and routing aid"},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["model_id", "status", "availability", "task_cells"],
        "properties": {
          "model_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["provisional", "confirmed", "unranked", "excluded"]},
          "availability": {"type": "string", "enum": ["eligible", "excluded"]},
          "task_cells": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "task_id",
                "attempted_runs",
                "completed_execution_records",
                "execution_blocked_runs",
                "all_attempt_process_or_timeout_failures",
                "resolved_identity_runs",
                "parseable_output_runs",
                "non_json_output_runs",
                "all_attempt_hard_failure_runs",
                "all_attempt_hard_failure_entries",
                "all_attempt_invalid_output_runs",
                "all_attempt_automatic_check_pass_runs",
                "evaluator_blocked_runs",
                "comparable_runs",
                "comparable_resolved_runs",
                "excluded_runs",
                "excluded_provider_or_identity_runs",
                "blocked_or_unverified_runs",
                "comparable_full_contract_pass_runs",
                "full_contract_pass_runs",
                "comparable_automatic_check_pass_runs",
                "all_automatic_checks_pass_runs",
                "comparable_process_or_timeout_failures",
                "comparable_hard_failure_runs",
                "hard_failure_runs",
                "comparable_invalid_output_runs",
                "invalid_output_runs",
                "process_or_timeout_failures"
              ],
              "properties": {
                "task_id": {"type": "string", "minLength": 1},
                "attempted_runs": {"type": "integer", "exclusiveMinimum": -1},
                "completed_execution_records": {"type": "integer", "exclusiveMinimum": -1},
                "execution_blocked_runs": {"type": "integer", "exclusiveMinimum": -1},
                "all_attempt_process_or_timeout_failures": {"type": "integer", "exclusiveMinimum": -1},
                "resolved_identity_runs": {"type": "integer", "exclusiveMinimum": -1},
                "parseable_output_runs": {"type": "integer", "exclusiveMinimum": -1},
                "non_json_output_runs": {"type": "integer", "exclusiveMinimum": -1},
                "all_attempt_hard_failure_runs": {"type": "integer", "exclusiveMinimum": -1},
                "all_attempt_hard_failure_entries": {"type": "integer", "exclusiveMinimum": -1},
                "all_attempt_invalid_output_runs": {"type": "integer", "exclusiveMinimum": -1},
                "all_attempt_automatic_check_pass_runs": {"type": "integer", "exclusiveMinimum": -1},
                "evaluator_blocked_runs": {"type": "integer", "exclusiveMinimum": -1},
                "comparable_runs": {"type": "integer", "exclusiveMinimum": -1},
                "comparable_resolved_runs": {"type": "integer", "exclusiveMinimum": -1},
                "excluded_runs": {"type": "integer", "exclusiveMinimum": -1},
                "excluded_provider_or_identity_runs": {"type": "integer", "exclusiveMinimum": -1},
                "blocked_or_unverified_runs": {"type": "integer", "exclusiveMinimum": -1},
                "comparable_full_contract_pass_runs": {"type": "integer", "exclusiveMinimum": -1},
                "full_contract_pass_runs": {"type": "integer", "exclusiveMinimum": -1},
                "comparable_automatic_check_pass_runs": {"type": "integer", "exclusiveMinimum": -1},
                "all_automatic_checks_pass_runs": {"type": "integer", "exclusiveMinimum": -1},
                "comparable_process_or_timeout_failures": {"type": "integer", "exclusiveMinimum": -1},
                "comparable_hard_failure_runs": {"type": "integer", "exclusiveMinimum": -1},
                "hard_failure_runs": {"type": "integer", "exclusiveMinimum": -1},
                "comparable_invalid_output_runs": {"type": "integer", "exclusiveMinimum": -1},
                "invalid_output_runs": {"type": "integer", "exclusiveMinimum": -1},
                "process_or_timeout_failures": {"type": "integer", "exclusiveMinimum": -1}
              }
            }
          }
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned_cells",
        "launch_failures",
        "attempted_runs",
        "completed_execution_records",
        "execution_blocked_runs",
        "all_attempt_process_or_timeout_failures",
        "resolved_identity_runs",
        "parseable_output_runs",
        "non_json_output_runs",
        "all_attempt_hard_failure_runs",
        "all_attempt_hard_failure_entries",
        "all_attempt_invalid_output_runs",
        "evaluator_blocked_runs",
        "comparable_resolved_runs",
        "excluded_provider_or_identity_runs",
        "blocked_or_unverified_runs",
        "comparable_full_contract_pass_runs",
        "full_contract_pass_runs",
        "comparable_automatic_check_pass_runs",
        "all_attempt_automatic_check_pass_runs",
        "all_automatic_checks_pass_runs",
        "comparable_process_or_timeout_failures",
        "comparable_hard_failure_runs",
        "hard_failure_runs",
        "comparable_invalid_output_runs",
        "invalid_output_runs",
        "process_or_timeout_failures",
        "human_scores_assigned"
      ],
      "properties": {
        "planned_cells": {"type": "integer", "exclusiveMinimum": -1},
        "launch_failures": {"type": "integer", "exclusiveMinimum": -1},
        "attempted_runs": {"type": "integer", "exclusiveMinimum": -1},
        "completed_execution_records": {"type": "integer", "exclusiveMinimum": -1},
        "execution_blocked_runs": {"type": "integer", "exclusiveMinimum": -1},
        "all_attempt_process_or_timeout_failures": {"type": "integer", "exclusiveMinimum": -1},
        "resolved_identity_runs": {"type": "integer", "exclusiveMinimum": -1},
        "parseable_output_runs": {"type": "integer", "exclusiveMinimum": -1},
        "non_json_output_runs": {"type": "integer", "exclusiveMinimum": -1},
        "all_attempt_hard_failure_runs": {"type": "integer", "exclusiveMinimum": -1},
        "all_attempt_hard_failure_entries": {"type": "integer", "exclusiveMinimum": -1},
        "all_attempt_invalid_output_runs": {"type": "integer", "exclusiveMinimum": -1},
        "evaluator_blocked_runs": {"type": "integer", "exclusiveMinimum": -1},
        "comparable_resolved_runs": {"type": "integer", "exclusiveMinimum": -1},
        "excluded_provider_or_identity_runs": {"type": "integer", "exclusiveMinimum": -1},
        "blocked_or_unverified_runs": {"type": "integer", "exclusiveMinimum": -1},
        "comparable_full_contract_pass_runs": {"type": "integer", "exclusiveMinimum": -1},
        "full_contract_pass_runs": {"type": "integer", "exclusiveMinimum": -1},
        "comparable_automatic_check_pass_runs": {"type": "integer", "exclusiveMinimum": -1},
        "all_attempt_automatic_check_pass_runs": {"type": "integer", "exclusiveMinimum": -1},
        "all_automatic_checks_pass_runs": {"type": "integer", "exclusiveMinimum": -1},
        "comparable_process_or_timeout_failures": {"type": "integer", "exclusiveMinimum": -1},
        "comparable_hard_failure_runs": {"type": "integer", "exclusiveMinimum": -1},
        "hard_failure_runs": {"type": "integer", "exclusiveMinimum": -1},
        "comparable_invalid_output_runs": {"type": "integer", "exclusiveMinimum": -1},
        "invalid_output_runs": {"type": "integer", "exclusiveMinimum": -1},
        "process_or_timeout_failures": {"type": "integer", "exclusiveMinimum": -1},
        "human_scores_assigned": {"type": "boolean"}
      }
    },
    "overall": {"type": "object", "additionalProperties": true},
    "profiles": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": true}},
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ranking_available",
        "score_publishable",
        "human_scores_assigned",
        "routing_recommendation_allowed",
        "reason"
      ],
      "properties": {
        "ranking_available": {"type": "boolean"},
        "score_publishable": {"type": "boolean"},
        "human_scores_assigned": {"type": "boolean"},
        "routing_recommendation_allowed": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "input": {"type": "object", "additionalProperties": true}
  }
}
