{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/calvinnwq/agent-profile-benchmark/blob/main/schemas/tolerant-comparison.schema.json",
  "title": "Tolerant objective comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "benchmark_id",
    "benchmark_version",
    "high_analysis_id",
    "medium_analysis_id",
    "sample_scopes",
    "overall",
    "models",
    "interpretation"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "$id": {"type": "string"},
    "schema_version": {"type": "string", "const": "tolerant-comparison-v1"},
    "benchmark_id": {"type": "string", "const": "agent-profile-benchmark"},
    "benchmark_version": {"type": "string", "const": "0.4.0"},
    "high_analysis_id": {"type": "string", "minLength": 1},
    "medium_analysis_id": {"type": "string", "minLength": 1},
    "sample_scopes": {"type": "object", "additionalProperties": true},
    "overall": {"type": "object", "additionalProperties": true},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "additionalProperties": true}
    },
    "interpretation": {"type": "object", "additionalProperties": true}
  }
}
